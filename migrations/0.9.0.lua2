-- Mapping: old -> new recipe names
local recipe_map = {
  ["old-a"] = "new-a",
  ["old-b"] = "new-b",
  -- beliebig erweiterbar
}

-- safety check: does the new recipe exist?
local function recipe_exists(name)
  return game.recipe_prototypes[name] ~= nil
end

-- 1. Forces
for _, force in pairs(game.forces) do
  for old, new in pairs(recipe_map) do
    if recipe_exists(new) and force.recipes[old] then
      local old_r = force.recipes[old]
      local new_r = force.recipes[new]

      -- sync enabled-Status
      if old_r.enabled then
        new_r.enabled = true
      end

      -- Optional: sync Hidden / visible
      new_r.hidden = old_r.hidden
    end
  end
end

-- 2. Technologies (if recipes are coupled to technologies)
for _, force in pairs(game.forces) do
  for _, tech in pairs(force.technologies) do
    if tech.researched then
      for _, effect in pairs(tech.effects or {}) do
        if effect.type == "unlock-recipe" then
          local new = recipe_map[effect.recipe]
          if new and recipe_exists(new) then
            force.recipes[new].enabled = true
          end
        end
      end
    end
  end
end

-- 3. Replace running recipes in machines
for _, surface in pairs(game.surfaces) do
  local entities = surface.find_entities_filtered{
    type = {
      "assembling-machine",
      "furnace",
      "rocket-silo"
    }
  }

  for _, entity in pairs(entities) do
    local recipe = entity.get_recipe()
    if recipe then
      local new = recipe_map[recipe.name]
      if new and recipe_exists(new) then
        -- replace recipe
        entity.set_recipe(new)
      end
    end
  end
end

-- 4. Charakter-Crafting Queue
for _, player in pairs(game.players) do
  local queue = player.crafting_queue
  if queue then
    for i = #queue, 1, -1 do
      local entry = queue[i]
      local new = recipe_map[entry.recipe]
      if new and recipe_exists(new) then
        player.cancel_crafting({index = i, count = entry.count})
        player.begin_crafting{
          count = entry.count,
          recipe = new
        }
      end
    end
  end
end